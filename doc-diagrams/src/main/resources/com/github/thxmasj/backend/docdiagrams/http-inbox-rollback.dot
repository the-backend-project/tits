// How a rollback finds a request of an inbox request, and the events the request caused on the application. Each
// entity is a stack of its events, oldest on top, under the name of its entity model, with the kind of entity as a
// stereotype. An event with a dashed border, in italics, leads to a choice, and is not stored: only the event of the
// chosen transition is. Solid arrows are triggers, dashed arrows event references. The colours are those of the other
// diagrams. The headers are in #353b16, which GraphvizFormatter draws in a light colour in dark mode.
digraph rollback {
  graph [rankdir=LR, nodesep=0.6, ranksep=1.3, fontname="Helvetica", bgcolor="transparent"]
  node [shape=plain, fontname="Helvetica", fontsize=11]
  edge [fontname="Helvetica", fontsize=10, color="#4b5320", fontcolor="#000000"]

  put [label=<
    <table border="0" cellborder="1" cellspacing="2" cellpadding="6" color="#4b5320">
      <tr><td border="0"><font color="#353b16"><font point-size="9">«Entity»</font><br/><b>RequestRouting</b></font></td></tr>
      <tr><td port="received" bgcolor="#9bb08a" style="dashed"><i>Request received</i><br/>PUT /orders/42</td></tr>
      <tr><td port="routed" bgcolor="#9bb08a">Request routed</td></tr>
      <tr><td port="response" bgcolor="#9bb08a">Response created<br/>201 Created</td></tr>
    </table>>]

  delete [label=<
    <table border="0" cellborder="1" cellspacing="2" cellpadding="6" color="#4b5320">
      <tr><td border="0"><font color="#353b16"><font point-size="9">«Entity»</font><br/><b>RequestRouting</b></font></td></tr>
      <tr><td port="received" bgcolor="#9bb08a" style="dashed"><i>Request received</i><br/>DELETE /orders/42</td></tr>
      <tr><td port="routed" bgcolor="#9bb08a">Request routed</td></tr>
      <tr><td port="response" bgcolor="#9bb08a">Response created<br/>201 Created</td></tr>
    </table>>]

  request [label=<
    <table border="0" cellborder="1" cellspacing="2" cellpadding="6" color="#4b5320">
      <tr><td border="0"><font color="#353b16"><font point-size="9">«HttpInboxRequest»</font><br/><b>PlaceOrder</b></font></td></tr>
      <tr><td port="received" bgcolor="#9bb08a" style="dashed"><i>Request received</i></td></tr>
      <tr><td port="claim" bgcolor="#9bb08a" style="dashed"><i>Request validated</i></td></tr>
      <tr><td port="dispatched" bgcolor="#9bb08a" style="dashed"><i>Request dispatched</i></td></tr>
      <tr><td port="accepted" bgcolor="#9bb08a">Request accepted<br/>EventReference(order, n)</td></tr>
      <tr><td port="completed" bgcolor="#9bb08a">Request completed</td></tr>
      <tr><td port="rb_received" bgcolor="#9bb08a" style="dashed"><i>Rollback request received</i></td></tr>
      <tr><td port="rb_accepted" bgcolor="#9bb08a">Rollback request accepted<br/>EventReference(order, n + 1)</td></tr>
      <tr><td port="rb_completed" bgcolor="#9bb08a">Rollback request completed</td></tr>
    </table>>]

  ids [label=<
    <table border="0" cellborder="1" cellspacing="2" cellpadding="6" color="#4b5320">
      <tr><td border="0"><font color="#353b16"><font point-size="9">«IdEntity»</font><br/><b>MessageIds</b></font></td></tr>
      <tr><td port="claimed" bgcolor="#9bb08a">Message id claimed<br/>(subject, 42)</td></tr>
      <tr><td port="rb_claimed" bgcolor="#9bb08a">Rollback message id claimed<br/>(subject, 42)</td></tr>
    </table>>]

  order [label=<
    <table border="0" cellborder="1" cellspacing="2" cellpadding="6" color="#4b5320">
      <tr><td border="0"><font color="#353b16"><font point-size="9">«Entity»</font><br/><b>Order</b></font></td></tr>
      <tr><td port="before" bgcolor="#9bb08a">n − 1: …</td></tr>
      <tr><td port="placed" bgcolor="#9bb08a">n: Order placed</td></tr>
      <tr><td port="rolled_back" bgcolor="#9bb08a">n + 1: Events rolled back<br/>toNumber n − 1</td></tr>
    </table>>]

  // Triggers
  put:routed:e -> request:received:w [label="new entity"]
  delete:routed:e -> request:rb_received:w [taillabel="selected by\nmessage id 42", labelangle=30, labeldistance=6]
  request:dispatched:e -> order:placed:w [label="process"]
  request:rb_received:e -> order:rolled_back:w [label="rolls back to before\nthe event referred to"]
  // Triggers against the direction of the layout are drawn reversed, so that they don't loop around the stacks
  request:completed:e -> order:placed:w [dir=back, label="the application responds"]
  put:response:e -> request:completed:w [dir=back]
  ids:claimed:e -> request:claim:w [dir=back, label="deduplicateOn gives 42"]
  ids:rb_claimed:e -> request:rb_accepted:w [dir=back]
  delete:response:e -> request:rb_completed:w [dir=back]

  // Event references
  request:accepted:e -> order:placed:w [style=dashed, label="refers to"]
  request:rb_accepted:e -> order:rolled_back:w [style=dashed, label="refers to"]

  {rank=same; put -> ids -> delete [style=invis]}
}
