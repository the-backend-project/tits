<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>com.github.thxmasj.backend</groupId>
    <artifactId>backend-parent</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>identity-provider</artifactId>

  <properties>
    <java.module.name>com.github.thxmasj.backend.identityprovider</java.module.name>
    <!-- Not a library -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <build>
    <finalName>identity-provider</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.github.thxmasj.backend.identityprovider.IdentityProvider</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Microsoft Entra ID authentication to Azure SQL, see DATABASE_AUTHENTICATION. Only for the JVM, as the native
           image does not build with azure-identity. -->
      <id>entra-id</id>
      <dependencies>
        <dependency>
          <!-- Loaded by mssql-jdbc when it connects with Entra ID -->
          <groupId>com.azure</groupId>
          <artifactId>azure-identity</artifactId>
          <scope>runtime</scope>
        </dependency>
        <dependency>
          <!-- The HTTP client of azure-identity, instead of that on Netty 4.1 -->
          <groupId>com.azure</groupId>
          <artifactId>azure-core-http-jdk-httpclient</artifactId>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>com.github.thxmasj.backend</groupId>
      <artifactId>http-inbox</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
    </dependency>
    <dependency>
      <!-- Verifies the secrets of imported clients against their BCrypt hashes -->
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.thxmasj.backend</groupId>
      <artifactId>database-mssql</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.thxmasj.backend</groupId>
      <artifactId>database-pgsql-jdbc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.thxmasj.backend</groupId>
      <artifactId>database-pgsql-r2dbc</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.thxmasj.backend</groupId>
      <artifactId>database-pgsql-vertx</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.thxmasj.backend</groupId>
      <artifactId>core</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- For the BCryptPasswordEncoder the hashes of the imported clients are made with -->
      <groupId>commons-logging</groupId>
      <artifactId>commons-logging</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
