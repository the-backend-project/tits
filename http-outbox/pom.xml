<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>com.github.thxmasj.backend</groupId>
    <artifactId>backend-parent</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>http-outbox</artifactId>

  <properties>
    <java.module.name>com.github.thxmasj.backend.http.outbox</java.module.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.github.thxmasj.backend</groupId>
      <artifactId>core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.thxmasj.backend</groupId>
      <artifactId>core</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.thxmasj.backend</groupId>
      <artifactId>database-mssql</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.thxmasj.backend</groupId>
      <artifactId>database-pgsql-jdbc</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.thxmasj.backend</groupId>
      <artifactId>database-pgsql-r2dbc</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.thxmasj.backend</groupId>
      <artifactId>database-pgsql-vertx</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- A test looks up the outbox request a process dispatched in the storage, which core exports only to the database
           modules and test-api, so the tests are given access to it -->
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs combine.children="append">
                <arg>--add-exports=com.github.thxmasj.backend.core/com.github.thxmasj.backend.core.internal.database=${java.module.name},ALL-UNNAMED</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The arguments of the parent, and the access to the storage -->
          <argLine>--add-modules=jdk.httpserver,java.net.http --add-reads=${java.module.name}=jdk.httpserver,java.net.http --add-exports=com.github.thxmasj.backend.core/com.github.thxmasj.backend.core.internal.database=${java.module.name},ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
